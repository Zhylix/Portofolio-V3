{
    frankenphp
    order php_server before file_server
}

:{$PORT:10000} {
    root * /app/public
    encode zstd gzip

    # Cache static assets
    @static {
        file
        path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.webp *.svg *.woff *.woff2 *.ttf *.eot
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    php_server
}
